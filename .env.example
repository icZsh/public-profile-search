# Local prototype only. Never use these values in a deployed environment.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://profile:profile@localhost:55432/profile_search
REDIS_URL=redis://localhost:56379/0
PROTOTYPE_HMAC_KEY=replace-with-at-least-32-random-characters
PROTOTYPE_API_TOKEN=local-prototype-token
PROTOTYPE_ADMIN_TOKEN=local-prototype-admin-token
PROTOTYPE_USER_ID=11111111-1111-4111-8111-111111111111
PROTOTYPE_JOBS_ENABLED=true
PROTOTYPE_REPORT_READS_ENABLED=true
PROTOTYPE_ALLOWED_ORIGINS=http://localhost:3417
# Local example only; replace with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROFILE_URL_ENCRYPTION_KEY=O_zdxoJwfVA_pJWpHc3vLwKtGqDRjdXyiNQjW4WLJew=
GITHUB_PROVIDER_ENABLED=true
GITHUB_API_VERSION=2026-03-10
# Optional, server-side only. Never prefix this variable with NEXT_PUBLIC_.
GITHUB_API_TOKEN=
PROFESSIONAL_SEARCH_ENABLED=true
EXA_PEOPLE_SEARCH_ENABLED=true
# Optional, server-side only. Without it, the Exa run is recorded as skipped.
EXA_API_KEY=
GITHUB_PEOPLE_SEARCH_ENABLED=true
PROFESSIONAL_SEARCH_MAX_RESULTS_PER_QUERY=5
PROFESSIONAL_SEARCH_MAX_GITHUB_PROFILES=3
PROFESSIONAL_SEARCH_RUN_LEASE_SECONDS=60
# These values define Deep's adaptive job-level retrieval envelope and are upper bounds
# for Quick. Quick is additionally capped at 2 names, 6 queries/requests, 10 profiles,
# and 40 seconds, and schedules Exa only. Each run receives a deterministic share.
# MAX_PROFILES caps retained unique profiles; Exa still uses the per-query limit above
# so duplicate results do not erase recall.
ADAPTIVE_PROFESSIONAL_SEARCH_MAX_NAMES=4
ADAPTIVE_PROFESSIONAL_SEARCH_MAX_QUERIES=20
ADAPTIVE_PROFESSIONAL_SEARCH_MAX_REQUESTS=32
ADAPTIVE_PROFESSIONAL_SEARCH_MAX_PROFILES=30
ADAPTIVE_PROFESSIONAL_SEARCH_BUDGET_SECONDS=120
ADAPTIVE_PROFESSIONAL_SEARCH_STAGNATION_QUERIES=3
# Optional, server-side only. Deep mode records a deterministic fallback when absent.
GROUNDED_SYNTHESIS_ENABLED=true
# Supported gateways: openrouter or openai. OpenRouter uses its stateless Responses API.
GROUNDED_SYNTHESIS_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_SYNTHESIS_MODEL="~deepseek/deepseek-v4-flash-latest"
OPENROUTER_HTTP_REFERER=http://localhost:3417
OPENROUTER_APP_TITLE="tracebrief local prototype"
# Direct OpenAI remains available by selecting GROUNDED_SYNTHESIS_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_SYNTHESIS_MODEL=gpt-5.6-sol
GROUNDED_SYNTHESIS_REASONING_EFFORT=medium
GROUNDED_SYNTHESIS_MAX_OUTPUT_TOKENS=16000
GROUNDED_SYNTHESIS_MAX_ATTEMPTS=3
GROUNDED_SYNTHESIS_RETRY_BACKOFF_SECONDS=2
GROUNDED_SYNTHESIS_RUN_LEASE_SECONDS=120
GROUNDED_SYNTHESIS_MAX_EVIDENCE_ITEMS=40
GROUNDED_SYNTHESIS_MAX_EVIDENCE_CHARACTERS=60000
MAIGRET_ENABLED=true
MAIGRET_CATALOG_MANIFEST=config/maigret-catalog-v0.6.3.json
MAIGRET_RUN_LEASE_SECONDS=180
MAIGRET_MAX_SHARDS_PER_JOB=10
SAFE_FETCH_MAX_BYTES=262144
SAFE_FETCH_TOTAL_TIMEOUT_SECONDS=8
SAFE_FETCH_CONNECT_TIMEOUT_SECONDS=3
SAFE_FETCH_READ_TIMEOUT_SECONDS=5
ELIGIBILITY_CHALLENGE_TTL_MINUTES=30
ELIGIBILITY_REVIEW_TTL_HOURS=24
ELIGIBILITY_APPROVAL_TTL_HOURS=24
ELIGIBILITY_MAX_ATTEMPTS=5
ELIGIBILITY_CHECK_COOLDOWN_SECONDS=3

NEXT_PUBLIC_API_BASE_URL=http://localhost:8800
NEXT_PUBLIC_PROTOTYPE_API_TOKEN=local-prototype-token
NEXT_PUBLIC_PROTOTYPE_USER_ID=11111111-1111-4111-8111-111111111111
